# Copy this file outside the repository or to a gitignored private path.
# Fill every value and pass it with --env-file. Empty or unresolved values are
# rejected before SSH is attempted. Paths must be absolute on the remote hosts.
#
# Node targets are derived as <LMS_FLEET_SSH_USER>@<canonical-node-id> so an
# operator does not have to hand-compose nine SSH targets.
#
# Do not commit real usernames, filesystem paths, credentials, private DNS names,
# or Tailscale IP addresses.

LMS_EXPECTED_COMMIT=
LMS_FLEET_SSH_USER=

# Common Linux paths. Override the checked-in template privately when a specific
# node differs; do not add ad-hoc command-line substitutions during a run.
LMS_LINUX_REPO_DIR=
LMS_LINUX_PYTHON=
LMS_LINUX_MODEL_ROOT=

# Common macOS paths.
LMS_MACOS_REPO_DIR=
LMS_MACOS_PYTHON=
LMS_MACOS_MODEL_ROOT=
