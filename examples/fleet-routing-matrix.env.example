# AssistX publication credentials. Load from a protected file or secret store.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me
ASSISTX_BASE_URL=http://127.0.0.1:8000

# Controller inputs and output.
LMS_FLEET_ROLE_POLICY=/home/scott/.config/lms-fleet/fleet-role-policy.v1.json
LMS_FLEET_MATRIX_OUT=/home/scott/.local/state/lms-fleet/fleet-routing-matrix.json
LMS_FLEET_COMPARISON_DIR=/home/scott/lms-fleet-runs/compare

# Fail a refresh when the controller sees only a partial one- or two-node view.
LMS_FLEET_MIN_DISCOVERED_NODES=3
LMS_FLEET_PUBLISH_TO_ASSISTX=true
