# Copy this file outside the repository or to a gitignored private path.
# Fill every value and pass it with --env-file. Empty or unresolved values are
# rejected before SSH is attempted. Repository, Python, and model paths must be
# absolute paths on the corresponding remote machine.

# Example target: <ssh-user>@<x1-private-hostname>
LMS_X1_SSH_TARGET=
LMS_X1_REPO_DIR=
LMS_X1_PYTHON=
LMS_X1_MODEL_ROOT=

# Example target: <ssh-user>@<xwing-private-hostname>
LMS_XWING_SSH_TARGET=
LMS_XWING_REPO_DIR=
LMS_XWING_PYTHON=
LMS_XWING_MODEL_ROOT=

# Example target: <ssh-user>@<macbook-air-private-hostname>
LMS_AIR_SSH_TARGET=
LMS_AIR_REPO_DIR=
LMS_AIR_PYTHON=
LMS_AIR_MODEL_ROOT=
