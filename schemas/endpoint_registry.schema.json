{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scottjoyner/lms/schemas/endpoint_registry.schema.json",
  "title": "LMS Bench Endpoint Registry",
  "type": "object",
  "required": ["schema_version", "endpoints"],
  "properties": {
    "schema_version": {"type": "string", "const": "lms_endpoint_registry.v1"},
    "created_at_utc": {"type": "string"},
    "updated_at_utc": {"type": "string"},
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "base_url", "enabled", "tags"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "base_url": {"type": "string", "pattern": "^https?://.+/v1$"},
          "enabled": {"type": "boolean"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"},
          "created_at_utc": {"type": "string"},
          "updated_at_utc": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
