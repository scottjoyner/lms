[Unit]
Description=Load daily-driver LLM into LM Studio after server start
Wants=lm-studio-api-start.service
After=lm-studio-api-start.service

[Service]
Type=oneshot
# Wait until the local server answers, then load the production model.
# Per-model defaults (FA on, KV q8_0, parallel 16, ctx 65536, MTP off) are
# applied automatically from ~/.lmstudio/.internal/user-concrete-model-default-config/
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do /usr/bin/curl -fsS --max-time 3 http://127.0.0.1:1234/v1/models >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
ExecStart=/bin/sh -c '/home/scott/.lmstudio/bin/lms ps 2>/dev/null | grep -q "ornith-1.5-35b-a3b-apex-mtp.*Local" && exit 0; exec /home/scott/.lmstudio/bin/lms load ornith-1.5-35b-a3b-apex-mtp --gpu max'

[Install]
WantedBy=default.target
